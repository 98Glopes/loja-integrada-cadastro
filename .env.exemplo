# Copie para `.env` na raiz do projeto (o `.env` é ignorado pelo git).
# Variáveis comentadas mostram o valor padrão; só as marcadas como obrigatórias
# precisam ser definidas, e apenas pelo comando que as usa.

# --- API Anthropic (obrigatória para `processar`) ---
# ANTHROPIC_API_KEY=
# LLM_MODELO_COPYWRITER=claude-opus-5
# LLM_MODELO_SEO=claude-opus-5
# LLM_MODELO_QA=claude-opus-5
# LLM_EFFORT_COPYWRITER=high
# LLM_EFFORT_SEO=medium
# LLM_EFFORT_QA=medium
# LLM_MAX_TENTATIVAS_QA=2

# --- Cloudflare R2 (obrigatórias para `processar`) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_URL_PUBLICA=https://bucket.exemplo.com

# --- Processamento de imagem ---
# IMAGEM_LADO_MAX_PX=1600
# IMAGEM_TAMANHO_MAX_KB=500

# --- Padrões dos produtos ---
# PRODUTO_ATIVO=S
# PESO_KG=0.1
# ALTURA_CM=4
# LARGURA_CM=22
# COMPRIMENTO_CM=22

# --- Loja e workspace ---
# LOJA_URL=https://www.kmilaamodas.com.br
# LOTES_DIR=./lotes
